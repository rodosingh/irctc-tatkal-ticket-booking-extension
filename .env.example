# Details file for "Import from file" under Login Details on the options page.
# Copy this to .env, fill in your own values, then pick that file in the options page.
# .env is ignored by git, so your details stay on your machine.
# Only the three names below are read; any other line is skipped. Values may be quoted.
user-id: your-irctc-username
password: your-irctc-password
mobile: 9876543210

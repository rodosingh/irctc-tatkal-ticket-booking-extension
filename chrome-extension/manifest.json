{
  "name": "Tatkal Ticket Booking",
  "version": "6.3.4",
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "description": "Fills in the IRCTC booking pages from details you save beforehand. You type each captcha. Unofficial, and no ticket is guaranteed.",
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.irctc.co.in/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.irctc.co.in/*",
    "https://api.ocr.space/*"
  ],
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "64": "assets/icon-64.png",
      "128": "assets/icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "64": "assets/icon-64.png",
    "128": "assets/icon-128.png"
  }
}
